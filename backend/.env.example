# Backend configuration.
#
# Only DATABASE_URL and JWT_SECRET are app-owned config the platform always
# provisions. Everything else is optional: a missing third-party key degrades
# that one feature (503 at call time) instead of crash-looping the pod.

# Required — Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Required — JWT signing secret. Never commit a real value; the deployment
# reads this from a Kubernetes Secret. If unset the API still starts, but it
# signs with an ephemeral key and every token dies on restart.
JWT_SECRET="change-me-in-every-real-environment"

# Optional — token lifetime, any `ms`-style span. Defaults to 12h.
JWT_EXPIRES_IN="12h"

# Optional — HTTP port. Defaults to 3001, matching colossus.yaml backend.port
# and the nginx proxy_pass target in frontend/nginx.conf.
PORT=3001

# Optional — restricts CORS to one origin. Unset reflects the request origin,
# which is what `ng serve` needs. Auth is a bearer token, never a cookie.
# FRONTEND_URL="http://localhost:4200"

# Optional — object storage. Surfaced in the admin settings panel; unset simply
# means the feature reports itself as unconfigured.
# MINIO_ENDPOINT=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Injected by Colossus at provision — consumed by prisma/seed/seed.js to
# materialise the platform-owned logins. Never hardcode accounts here.
# COLOSSUS_ACCOUNTS_JSON=
